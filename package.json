{
    "name": "keeweb-connect",
    "version": "1.0.0",
    "description": "KeeWeb Connect: Chrome (MV3) autofill extension for KeeWeb (unofficial fork)",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "webpack --mode=production",
        "build:dev": "webpack --mode=development",
        "watch": "webpack --mode=development --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:unit": "vitest run",
        "package": "ts-node scripts/package.ts",
        "clean": "ts-node scripts/clean.ts",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
        "download-translations": "ts-node scripts/download-translations.ts",
        "bump-version": "ts-node scripts/bump-version.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jesse23/keeweb-connect.git"
    },
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jesse23/keeweb-connect/issues"
    },
    "homepage": "https://github.com/jesse23/keeweb-connect#readme",
    "dependencies": {
        "preact": "^10.29.0",
        "tweetnacl": "^1.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/adm-zip": "^0.5.8",
        "@types/chrome": "^0.3.5",
        "@types/node": "^22.20.5",
        "adm-zip": "^0.6.1",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.10",
        "tiny-typed-emitter": "^2.1.0",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.4",
        "webpack": "^5.111.1",
        "webpack-cli": "^6.0.1"
    }
}
