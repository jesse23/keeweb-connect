{
    "branches": ["master"],
    "tagFormat": "v${version}",
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version --allow-same-version && npm run set-version -- ${nextRelease.version} && npm run build && npm run package",
                "successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": ["package.json", "package-lock.json", "manifest.json"],
                "message": "chore(release): v${nextRelease.version} [skip ci]"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    {
                        "path": "dist/keeweb-connect-chrome-*.zip"
                    }
                ]
            }
        ]
    ]
}
