{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node10",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["chrome", "node"],
        "preserveConstEnums": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "baseUrl": "src",
        "noEmit": true
    },
    "include": [
        "src/**/*",
        "scripts/**/*",
        "test/**/*",
        "webpack.config.ts",
        "eslint.config.mjs",
        "vitest.config.ts"
    ]
}
